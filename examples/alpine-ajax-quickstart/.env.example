# Copy to `.env` and fill in from your Proteles
# dashboard / Management API.

# Your tenant's issuer: exactly what its /.well-known/openid-configuration
# reports. In a multi-tenant deployment that is the tenant's own host, e.g.
# http://acme.localhost:8080 locally. Not a bare 127.0.0.1 unless the server
# serves your tenant there: one that routes tenants by host may answer 404.
PROTELES_ISSUER=http://localhost:8080

# The app (client) you created for this project.
PROTELES_CLIENT_ID=your-client-id
PROTELES_CLIENT_SECRET=your-client-secret

# This app's origin; the redirect URI is derived as
# ${PROTELES_APP_URL}/api/auth/callback. Register that exact URI on the client.
PROTELES_APP_URL=http://localhost:3700

# Encrypts the session/flow cookies. Generate 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROTELES_SESSION_SECRET=REPLACE_WITH_32_BYTE_BASE64

# Local dev is plain HTTP, so cookies can't be Secure. Remove this in production.
PROTELES_COOKIE_SECURE=false
