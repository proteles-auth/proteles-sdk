{
  "name": "@proteles/management",
  "version": "0.4.0",
  "description": "Typed client for the Proteles Management API (/api/v1/*): tenants, apps, API keys, connections, branding, and audit. Used by CI to provision tenants and apps. Needs a Proteles account: sign up for free at proteles.com.",
  "license": "MIT",
  "author": "Proteles",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proteles-auth/proteles-sdk.git",
    "directory": "packages/management"
  },
  "homepage": "https://github.com/proteles-auth/proteles-sdk/tree/main/packages/management#readme",
  "bugs": "https://github.com/proteles-auth/proteles-sdk/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "oauth2",
    "oidc",
    "management",
    "api",
    "proteles"
  ],
  "engines": {
    "node": ">=18.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
