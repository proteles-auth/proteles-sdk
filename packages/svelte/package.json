{
  "name": "@proteles/svelte",
  "version": "0.3.0",
  "description": "Svelte components and stores for Proteles authentication, plus SvelteKit server handlers. Works with Svelte 4 and 5; tokens never reach the browser. Needs a Proteles account: sign up for free at proteles.com.",
  "license": "MIT",
  "author": "Proteles",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proteles-auth/proteles-sdk.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/proteles-auth/proteles-sdk/tree/main/packages/svelte#readme",
  "bugs": "https://github.com/proteles-auth/proteles-sdk/issues",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist && node scripts/fix-component-dts.mjs && node scripts/drop-component-dts-maps.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@proteles/bff": "^0.3.0"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "svelte": "^5.0.0"
  },
  "keywords": [
    "oauth2",
    "oidc",
    "svelte",
    "sveltekit",
    "authentication",
    "proteles"
  ],
  "engines": {
    "node": ">=18.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "svelte": "./dist/index.js"
}
