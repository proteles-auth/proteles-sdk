{
  "name": "@proteles/react",
  "version": "0.3.0",
  "description": "Drop-in React components and hooks (SignInButton, UserButton, SignedIn/SignedOut, useUser, Protect) for the Proteles identity platform. Talks to the @proteles/next BFF, never to the authorization server directly. Needs a Proteles account: sign up for free at proteles.com.",
  "license": "MIT",
  "author": "Proteles",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proteles-auth/proteles-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/proteles-auth/proteles-sdk/tree/main/packages/react#readme",
  "bugs": "https://github.com/proteles-auth/proteles-sdk/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.tsx"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "oauth2",
    "oidc",
    "react",
    "nextjs",
    "authentication",
    "proteles"
  ],
  "engines": {
    "node": ">=18.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
