{
  "name": "@proteles/alpine",
  "version": "0.3.0",
  "description": "Alpine.js plugin for Proteles authentication: a reactive $auth store and x-signed-in / x-signed-out directives. Works with no build step via a CDN script tag. Tokens never reach the browser. Needs a Proteles account: sign up for free at proteles.com.",
  "license": "MIT",
  "author": "Proteles",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proteles-auth/proteles-sdk.git",
    "directory": "packages/alpine"
  },
  "homepage": "https://github.com/proteles-auth/proteles-sdk/tree/main/packages/alpine#readme",
  "bugs": "https://github.com/proteles-auth/proteles-sdk/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": "./dist/proteles-alpine.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "alpinejs": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "alpinejs": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "keywords": [
    "oauth2",
    "oidc",
    "alpine",
    "alpinejs",
    "authentication",
    "proteles"
  ],
  "engines": {
    "node": ">=18.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "./dist/proteles-alpine.js",
  "jsdelivr": "./dist/proteles-alpine.js"
}
